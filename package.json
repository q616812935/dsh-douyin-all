      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/q616812935/dsh-douyin-all.git",
    "directory": "plugin"
  },
