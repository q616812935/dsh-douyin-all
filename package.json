    "*.mjs",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "locale/"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "douyin",
    "抖音",
    "automation"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": false
    }
  },
  "dsh": {
